# Optional server-side defaults. Do not commit real keys.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini
PORT=4173

# Required as soon as OPENAI_API_KEY is set: without it live-model calls are
# refused outright, because a server-side key on a public URL with no gate means
# anyone can spend the model budget. Empty by default; rules mode never needs it.
ACCESS_PASSWORD=

# Optional public-data adapters. Keep real values in .env only.
SAM_GOV_API_KEY=
COMPANIES_HOUSE_API_KEY=

# SEC and some government APIs ask for an identified user agent.
# Example: ComplianceHubPrototype/0.1 compliance-team@example.com
COMPLIANCE_HUB_USER_AGENT=
