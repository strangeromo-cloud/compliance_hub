flowchart TD

%% Shape first, prose second. The long version of every box below is in the code
%% comment beside the thing it describes, and in guide.html for the parts a
%% reader needs. A diagram that repeats them is a third copy to keep in step.

FE["<b>浏览器三页</b><br/>工作台 · 数据源 · 使用说明"]
SH["<b>前后端共读的两份规则</b><br/>intent.js 意图与路由 · gems.js Gem 目录"]

FE --- SH
SH --> SRV["<b>server.js</b> · Node 24 · 依赖 0<br/>服务端有模型 key 时忽略前端传来的 baseUrl"]

SRV --> MINE["<b>自建 Gem / Skill</b><br/>skills · custom_gems 两张表<br/>斜杠命名空间一处检查，不许重名"]

SRV --> CLS["<b>意图判定</b><br/>先关键字规则；没命中再问一次模型<br/>「描述了交易就进审查」是硬闸，模型改不了"]

CLS --> KIND{"答复方式"}

KIND --> DET["<b>确定性部分 · 不调模型</b><br/>triage · clearance 五条件 · 路径规划<br/>名单筛查 · 名称比对 · 所有权穿透<br/>直查 / 简报 / 备忘录：0 次模型"]

KIND --> LLM["<b>调模型的四处</b><br/>专业线三次 + 综合一次 = 一次审查最多 4 次<br/>问答 1 次 · 意图判定 1 次<br/>没有可用模型时直接拒答，不存在规则模式"]

DET --> CAP["<b>agent-capabilities.js · 4 条能力</b><br/>纯函数，必带条文出处"]
CAP -.-> MCP["<b>mcp-server.js</b><br/>stdio JSON-RPC，只读能力"]

DET --> OWN["<b>ownership-graph.js</b><br/>四个来源合一张边表<br/>OFAC 50% 闭包；低于门槛不构成排除"]

%% 同步先声明，所以它排在这一层的最左边。放在右边时 agent-capabilities 到
%% mcp-server 的虚线要从它底下穿过去，看上去像是同步连出去的。
SYNC["<b>同步 · 32 个适配器</b><br/>取原文 → 归一 → 一次事务写入并记 SHA-256<br/>数据层唯一的写入方"] --> DB["<b>数据层 · SQLite · WAL</b><br/>11 张表 · 30 个源已入库<br/>编排层只读"]
MINE --> DB
OWN --> DB
CAP --> DB

LIVE["<b>运行时实时请求（不入库）</b><br/>引文 · 母公司链 · 持股"] -.-> DET

classDef master fill:#FAEEDA,stroke:#854F0B,stroke-width:1px,color:#412402
classDef agent  fill:#EEEDFE,stroke:#534AB7,stroke-width:1px,color:#26215C
classDef plain  fill:#F1EFE8,stroke:#5F5E5A,stroke-width:1px,color:#2C2C2A
classDef data   fill:#E1F5EE,stroke:#0F6E56,stroke-width:1px,color:#04342C

class SRV,LLM master
class CLS,DET,CAP,OWN,MINE agent
class FE,SH,MCP,KIND plain
class DB,SYNC,LIVE data
